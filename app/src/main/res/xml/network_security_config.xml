<?xml version="1.0" encoding="utf-8"?>
<!-- Muchas listas IPTV y el control del Roku (puerto 8060) usan http sin cifrar. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
